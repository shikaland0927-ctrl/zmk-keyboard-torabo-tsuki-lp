config ZMK_INPUT_PROCESSOR_GESTURES
    bool "Trackball flick gesture input processor"
    default y
    depends on ZMK_POINTING
    depends on DT_HAS_ZMK_INPUT_PROCESSOR_GESTURES_ENABLED
    depends on !ZMK_SPLIT || ZMK_SPLIT_ROLE_CENTRAL

config ZMK_BEHAVIOR_IPAD_MORPH
    bool "Behavior that picks its binding by host (Mac or the iPad's BLE profile)"
    default y
    depends on DT_HAS_ZMK_BEHAVIOR_IPAD_MORPH_ENABLED
    depends on !ZMK_SPLIT || ZMK_SPLIT_ROLE_CENTRAL

endmenu
