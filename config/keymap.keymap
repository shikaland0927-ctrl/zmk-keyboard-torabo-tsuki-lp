#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

&lt {
    tapping-term-ms = <150>;
    quick-tap-ms = <200>;
    flavor = "hold-preferred";
    hold-while-undecided;
    retro-tap;
};

/ {
    combos {
        compatible = "zmk,combos";

        bt_clear {
            bindings = <&bt BT_CLR>;
            key-positions = <28 29>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        DEFAULT {
            bindings = <
&trans  &trans  &trans  &trans  &trans     &trans                                            &trans           &trans  &trans  &trans  &trans  &trans
&trans  &kp Q   &kp L   &kp U   &kp COMMA  &kp DOT                                           &kp F            &kp W   &kp R   &kp Y   &kp P   &trans
&trans  &kp E   &kp I   &kp A   &kp O      &kp SEMI     &trans        &trans                 &kp K            &kp T   &kp N   &kp S   &kp H   &trans
&trans  &kp X   &kp J   &kp C   &kp V      &kp COLON    &kp CAPSLOCK  &kp LG(LA(LC(LS(R))))  &kp G            &kp D   &kp M   &kp Z   &kp B   &trans
&trans  &trans  &trans  &trans  &kp TAB    &lt 3 ENTER  &kp ESCAPE    &trans                 &lt 1 BACKSPACE  &trans  &trans  &trans  &trans  &trans
            >;
        };

        SYMBOL {
            bindings = <
&trans  &trans           &trans        &trans         &trans    &trans                     &trans  &trans  &trans  &trans  &trans  &trans
&trans  &kp EXCLAMATION  &kp QUESTION  &kp AMPERSAND  &kp PIPE  &kp TILDE                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans           &trans        &trans         &trans    &trans     &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans           &trans        &trans         &trans    &trans     &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans           &trans        &trans         &trans    &trans     &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        NAV {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        NUM {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };
    };
};
