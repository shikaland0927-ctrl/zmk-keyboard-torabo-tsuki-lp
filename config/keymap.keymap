#include <dt-bindings/zmk/input_transform.h>
#include <input/processors.dtsi>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>

// With any of these held, the JP-layer Q/L keys send plain Q/L (keeping the mods),
// so shortcuts like Cmd+Q and Cmd+L still work in Japanese mode.
#define JP_PASS_MODS (MOD_LGUI|MOD_RGUI|MOD_LCTL|MOD_RCTL|MOD_LALT|MOD_RALT|MOD_LSFT|MOD_RSFT)

// The BLE profile the iPad is paired on (&bt BT_SEL 1, the D key on SYSTEM).
// While it is in use, the trackball gestures send iPad shortcuts instead.
#define IPAD_BLE_PROFILE 1

// The key left of Esc sends Caps Lock, which the Mac and the iPad remap to Globe
// (Modifier Keys settings), so a tap opens the emoji picker. macOS drops a remapped
// Globe from key combos (Globe+Ctrl+F arrives as Ctrl+F), so no shortcut uses Globe.

&pointing_listener {
    input-processors =
        <&zip_xy_scaler 2 3>,
        <&zip_xy_transform (INPUT_TRANSFORM_X_INVERT | INPUT_TRANSFORM_Y_INVERT)>;

    scroll {
        layers = <4>;
        input-processors =
            <&zip_xy_scaler 2 3>,
            <&zip_xy_transform (INPUT_TRANSFORM_X_INVERT)>,
            <&zip_xy_to_scroll_mapper>,
            <&zip_scroll_scaler 1 16>;
    };

    gesture {
        layers = <5>;
        input-processors =
            <&zip_xy_transform (INPUT_TRANSFORM_X_INVERT | INPUT_TRANSFORM_Y_INVERT)>,
            <&zip_gestures>;
    };

    window {
        layers = <6>;
        input-processors =
            <&zip_xy_transform (INPUT_TRANSFORM_X_INVERT | INPUT_TRANSFORM_Y_INVERT)>,
            <&zip_window_gestures>;
    };
};

&lt {
    hold-while-undecided;
    flavor = "hold-preferred";
};

&mt { flavor = "balanced"; };

/ {
    // Flick the trackball while GESTURE (Esc) or WINDOW (A+O) is held to tap one of these
    // bindings (up, down, left, right). They are only reachable by flicking, not by keys.
    // None of the gestures is used repeatedly, so ignore the ball for 800 ms after one fires.
    // ipad-bindings replace them on the iPad's profile (USB and other profiles stay Mac).

    zip_gestures: zip_gestures {
        compatible = "zmk,input-processor-gestures";
        #input-processor-cells = <0>;
        // Mac: Mission Control, Raycast, show desktop, full screen.
        bindings =
            <&kp LC(UP_ARROW)>,
            <&kp LC(LA(LS(LG(R))))>,
            <&kp F11>,
            <&kp LG(LC(F))>;

        // iPad: App Switcher (mouse button 4, which the iPad's AssistiveTouch maps to
        // App Switcher), Spotlight, Home; right is not decided yet (same as Mac).
        ipad-bindings =
            <&mkp MB4>,
            <&kp LG(SPACE)>,
            <&kp LG(H)>,
            <&kp LG(LC(F))>;

        ipad-ble-profile = <IPAD_BLE_PROFILE>;
        cooldown-ms = <800>;
    };

    zip_window_gestures: zip_window_gestures {
        compatible = "zmk,input-processor-gestures";
        #input-processor-cells = <0>;
        bindings =
            <&kp LC(LG(UP_ARROW))>,
            <&kp LC(LG(DOWN_ARROW))>,
            <&kp LC(LG(LEFT_ARROW))>,
            <&kp LC(LG(RIGHT_ARROW))>;

        // iPad: off (the iPad runs Full Screen Apps, so there are no windows to tile).
        ipad-bindings =
            <&none>,
            <&none>,
            <&none>,
            <&none>;

        ipad-ble-profile = <IPAD_BLE_PROFILE>;
        cooldown-ms = <800>;
    };

    combos {
        compatible = "zmk,combos";

        kana {
            bindings = <&tn_combo 4 0>;
            key-positions = <33 34>;
            layers = <0 1>;
        };

        eisuu {
            bindings = <&ao_combo 6 0>;
            key-positions = <28 27>;
            layers = <0 1>;
        };

        mb1 {
            bindings = <&mkp MB1>;
            timeout-ms = <80>;
            key-positions = <33 19>;
        };

        mb2 {
            bindings = <&mkp MB2>;
            timeout-ms = <80>;
            key-positions = <35 21>;
        };

        mb3 {
            bindings = <&mkp MB3>;
            timeout-ms = <80>;
            key-positions = <34 20>;
        };

        // Tap both brightness keys to lock the screen; hold both for Ctrl+Alt as before.
        lock_screen {
            bindings = <&pair_mt LC(LEFT_ALT) LG(LC(Q))>;
            key-positions = <53 54>;
            layers = <0 1>;
        };

        // Tap both volume keys to mute; hold both for Ctrl+Alt as before.
        mute {
            bindings = <&pair_mt RC(RIGHT_ALT) C_MUTE>;
            key-positions = <63 64>;
            layers = <0 1>;
        };

        // Hold Enter and Tab together for SYSTEM (BLE profiles and output).
        system_layer {
            bindings = <&mo 7>;
            key-positions = <57 58>;
            layers = <0 1>;
        };
    };

    behaviors {
        lt_to_nav: lt_to_nav {
            compatible = "zmk,behavior-hold-tap";
            label = "LT_TO_NAV";
            bindings = <&mo_to_nav>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <150>;
            hold-while-undecided;
        };

        tog_on: tog_on {
            compatible = "zmk,behavior-toggle-layer";
            label = "TOG_ON";
            #binding-cells = <1>;
            toggle-mode = "on";
        };

        tog_off: tog_off {
            compatible = "zmk,behavior-toggle-layer";
            label = "TOG_OFF";
            #binding-cells = <1>;
            toggle-mode = "off";
        };

        left_in_nav: left_in_nav {
            compatible = "zmk,behavior-mod-morph";
            label = "LEFT_IN_NAV";
            bindings = <&kp LEFT_ARROW>, <&kp LEFT_ARROW>;

            #binding-cells = <0>;
            mods = <(MOD_RGUI)>;
        };

        down_in_nav: down_in_nav {
            compatible = "zmk,behavior-mod-morph";
            label = "DOWN_IN_NAV";
            bindings = <&kp DOWN_ARROW>, <&kp DOWN_ARROW>;

            #binding-cells = <0>;
            mods = <(MOD_RGUI)>;
        };

        up_in_nav: up_in_nav {
            compatible = "zmk,behavior-mod-morph";
            label = "UP_IN_NAV";
            bindings = <&kp UP_ARROW>, <&kp UP_ARROW>;

            #binding-cells = <0>;
            mods = <(MOD_RGUI)>;
        };

        right_in_nav: right_in_nav {
            compatible = "zmk,behavior-mod-morph";
            label = "RIGHT_IN_NAV";
            bindings = <&kp RIGHT_ARROW>, <&kp RIGHT_ARROW>;

            #binding-cells = <0>;
            mods = <(MOD_RGUI)>;
        };

        tn_combo: tn_combo {
            compatible = "zmk,behavior-hold-tap";
            label = "TN_COMBO";
            bindings = <&mo>, <&kana_jp>;

            #binding-cells = <2>;
            flavor = "hold-preferred";
            tapping-term-ms = <150>;
            hold-while-undecided;
        };

        ao_combo: ao_combo {
            compatible = "zmk,behavior-hold-tap";
            label = "AO_COMBO";
            bindings = <&mo>, <&eisuu_default>;

            #binding-cells = <2>;
            flavor = "hold-preferred";
            tapping-term-ms = <150>;
            hold-while-undecided;
        };

        // JP layer only: V types "xn" (ん) and X types MINUS (ー).
        // Romaji input only loses ヴ (vu), and L covers X's small kana (la, ltu, lya).
        // L stays plain so zh/zj/zk/zl still type the arrows.

        jp_v: jp_v {
            compatible = "zmk,behavior-mod-morph";
            label = "JP_V";
            bindings = <&xn_macro>, <&kp V>;

            #binding-cells = <0>;
            mods = <JP_PASS_MODS>;
            keep-mods = <JP_PASS_MODS>;
        };

        jp_x: jp_x {
            compatible = "zmk,behavior-mod-morph";
            label = "JP_X";
            bindings = <&kp MINUS>, <&kp X>;

            #binding-cells = <0>;
            mods = <JP_PASS_MODS>;
            keep-mods = <JP_PASS_MODS>;
        };

        my_mt: my_mt {
            compatible = "zmk,behavior-hold-tap";
            label = "MY_MT";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            flavor = "hold-preferred";
            tapping-term-ms = <200>;
            hold-while-undecided;
            balanced-key-positions = <56 57 58 59 60>;
        };

        // Binding for combos on two mod-tap keys: a quick tap sends the shortcut,
        // while holding them (or pressing any other key) keeps both mods.
        // hold-preferred, so an unclear press never fires the tap.
        pair_mt: pair_mt {
            compatible = "zmk,behavior-hold-tap";
            label = "PAIR_MT";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            flavor = "hold-preferred";
            tapping-term-ms = <200>;
        };
    };

    macros {
        mo_to_nav: mo_to_nav {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&mo 3 &kp RIGHT_GUI>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&mo 3 &kp RIGHT_GUI>;

            label = "MO_TO_NAV";
        };

        kp_in_nav: kp_in_nav {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings =
                <&macro_release>,
                <&kp RIGHT_GUI>,
                <&macro_tap>,
                <&macro_param_1to1 &kp MACRO_PLACEHOLDER>,
                <&macro_press>,
                <&kp RIGHT_GUI>;

            label = "KP_IN_NAV";
        };

        // Track the input mode only when the kana/eisuu combo is tapped.
        // Explicit on/off also lets repeated taps resynchronize with the host.

        kana_jp: kana_jp {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <30>;
            bindings = <&macro_press>, <&tog_on 1>, <&macro_tap>, <&kp LANG1>;

            label = "KANA_JP";
        };

        eisuu_default: eisuu_default {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <30>;
            bindings = <&macro_press>, <&tog_off 1>, <&macro_tap>, <&kp LANG2>;

            label = "EISUU_DEFAULT";
        };

        xn_macro: xn_macro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp X &kp N>;
            label = "XN_MACRO";
        };

        icloud: icloud {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp S &kp H &kp I &kp K &kp A &kp L &kp A &kp N &kp D &kp N0 &kp N9 &kp N2 &kp N7 &kp AT &kp I &kp C &kp L &kp O &kp U &kp D &kp DOT &kp C &kp O &kp M>;
            label = "ICLOUD";
        };

        eccs: eccs {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp S &kp H &kp I &kp K &kp A &kp L &kp A &kp N &kp D &kp N0 &kp N9 &kp N2 &kp N7 &kp AT &kp G &kp DOT &kp E &kp C &kp C &kp DOT &kp U &kp MINUS &kp T &kp O &kp K &kp Y &kp O &kp DOT &kp A &kp C &kp DOT &kp J &kp P>;
            label = "ECCS";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        DEFAULT {
            bindings = <
&trans  &trans                         &trans                             &trans         &trans        &trans                                                    &trans              &trans  &trans  &trans                           &trans                        &trans
&trans  &kp Q                          &kp Y                              &kp U          &kp J         &kp L                                                     &kp G               &kp D   &kp M   &kp Z                            &kp B                         &trans
&trans  &kp E                          &kp I                              &kp A          &kp O         &kp F        &trans                        &trans         &kp K               &kp T   &kp N   &kp S                            &kp H                         &trans
&trans  &my_mt LEFT_SHIFT COLON        &mt LEFT_GUI PERIOD                &kp C          &kp V         &kp X        &trans                        &trans         &kp P               &kp W   &kp R   &mt RIGHT_GUI COMMA              &my_mt RIGHT_SHIFT SEMICOLON  &trans
&trans  &mt LEFT_ALT C_BRIGHTNESS_DEC  &mt LEFT_CONTROL C_BRIGHTNESS_INC  &kp CAPS  &lt 5 ESCAPE  &lt 2 ENTER  &mt LC(LA(LS(LEFT_GUI))) TAB  &kp BACKSPACE  &lt_to_nav 0 SPACE  &trans  &trans  &mt RIGHT_CONTROL C_VOLUME_DOWN  &mt RIGHT_ALT C_VOLUME_UP     &trans
            >;
        };

        // Keep JP right above DEFAULT, so combos limited to DEFAULT/JP stay off
        // while SYMBOL or NAV is held. Only V (ん) and X (ー) differ from DEFAULT.

        JP {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &jp_v   &jp_x   &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        SYMBOL {
            bindings = <
&trans  &trans                &trans                &trans                &trans            &trans                       &trans     &trans                &trans             &trans                 &trans         &trans
&trans  &kp EXCLAMATION       &kp QUESTION          &kp AMPERSAND         &kp PIPE          &kp TILDE                    &trans     &kp LEFT_BRACE        &kp SQT            &kp RIGHT_BRACE        &kp BACKSLASH  &trans
&trans  &kp PLUS              &kp MINUS             &kp ASTERISK          &kp SLASH         &kp PERCENT  &trans  &trans  &trans     &kp LEFT_PARENTHESIS  &kp DOUBLE_QUOTES  &kp RIGHT_PARENTHESIS  &kp HASH       &trans
&trans  &kp CARET             &kp LESS_THAN         &kp EQUAL             &kp GREATER_THAN  &kp DOLLAR   &trans  &trans  &kp GRAVE  &kp LEFT_BRACKET      &kp UNDERSCORE     &kp RIGHT_BRACKET      &kp AT         &trans
&trans  &kp LG(LS(NUMBER_3))  &kp LG(LS(NUMBER_4))  &kp LG(LS(NUMBER_5))  &trans            &trans       &trans  &trans  &trans     &trans                &trans             &icloud                &eccs          &trans
            >;
        };

        NAV {
            bindings = <
&trans  &trans               &trans               &trans               &trans               &trans                             &trans                       &trans                           &trans                            &trans                        &trans                   &trans
&trans  &trans               &kp_in_nav N7        &kp_in_nav NUMBER_8  &kp_in_nav NUMBER_9  &kp_in_nav MINUS                   &kp_in_nav LC(LEFT_ARROW)    &kp GRAVE                        &kp TAB                           &kp_in_nav RC(RIGHT_ARROW)    &trans                   &trans
&trans  &trans               &kp_in_nav NUMBER_4  &kp_in_nav N5        &kp_in_nav NUMBER_6  &kp_in_nav PLUS    &trans  &trans  &left_in_nav                 &down_in_nav                     &up_in_nav                        &right_in_nav                 &kp_in_nav END           &trans
&trans  &kp_in_nav NUMBER_0  &kp_in_nav NUMBER_1  &kp_in_nav NUMBER_2  &kp_in_nav NUMBER_3  &kp_in_nav PERIOD  &trans  &trans  &kp_in_nav LG(LEFT_BRACKET)  &kp_in_nav LS(LG(LEFT_BRACKET))  &kp_in_nav RS(RG(RIGHT_BRACKET))  &kp_in_nav RG(RIGHT_BRACKET)  &trans                   &trans
&trans  &trans               &trans               &trans               &trans               &trans             &trans  &trans  &trans                       &trans                           &trans                            &trans                        &trans                   &trans
            >;
        };

        SCROLL {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        // Hold Esc to flick the trackball for &zip_gestures (keys stay transparent).

        GESTURE {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        // Hold A+O (tap is eisuu) to flick for &zip_window_gestures (keys stay transparent).

        WINDOW {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        // Hold Enter and Tab together (combo system_layer) to reach SYSTEM. Right hand:
        // top row = BLE profiles 0-4, home row = output to USB / BLE,
        // bottom row pinky side = clear this profile's pairing / clear all pairings.

        SYSTEM {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                  &trans          &trans          &trans          &trans          &trans          &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &bt BT_SEL 0    &bt BT_SEL 1    &bt BT_SEL 2    &bt BT_SEL 3    &bt BT_SEL 4    &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &out OUT_USB    &out OUT_BLE    &trans          &trans          &trans          &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans          &trans          &trans          &bt BT_CLR      &bt BT_CLR_ALL  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans          &trans          &trans          &trans          &trans          &trans
            >;
        };
    };
};
