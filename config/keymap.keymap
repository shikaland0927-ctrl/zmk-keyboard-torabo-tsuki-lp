#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

&lt {
    tapping-term-ms = <150>;
    quick-tap-ms = <200>;
    flavor = "hold-preferred";
    hold-while-undecided;
    retro-tap;
};

/ {
    combos {
        compatible = "zmk,combos";

        bt_clear {
            bindings = <&bt BT_CLR>;
            key-positions = <28 29>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        DEFAULT {
            bindings = <
&trans  &trans  &trans  &trans  &trans     &trans                                            &trans           &trans  &trans  &trans  &trans  &trans
&trans  &kp Q   &kp L   &kp U   &kp COMMA  &kp DOT                                           &kp F            &kp W   &kp R   &kp Y   &kp P   &trans
&trans  &kp E   &kp I   &kp A   &kp O      &kp SEMI     &trans        &trans                 &kp K            &kp T   &kp N   &kp S   &kp H   &trans
&trans  &kp X   &kp J   &kp C   &kp V      &kp COLON    &kp CAPSLOCK  &kp LG(LA(LC(LS(R))))  &kp G            &kp D   &kp M   &kp Z   &kp B   &trans
&trans  &trans  &trans  &trans  &kp TAB    &lt 3 ENTER  &kp ESCAPE    &trans                 &lt 1 BACKSPACE  &trans  &trans  &trans  &trans  &trans
            >;
        };

        SYMBOL {
            bindings = <
&trans  &trans           &trans         &trans         &trans            &trans                                  &trans     &trans                &trans             &trans                 &trans         &trans
&trans  &kp EXCLAMATION  &kp QUESTION   &kp AMPERSAND  &kp PIPE          &kp TILDE                               &trans     &kp LEFT_BRACE        &kp SQT            &kp RIGHT_BRACE        &kp AT_SIGN    &trans
&trans  &kp PLUS         &kp MINUS      &kp ASTERISK   &kp SLASH         &kp PERCENT     &trans          &trans  &trans     &kp LEFT_PARENTHESIS  &kp DOUBLE_QUOTES  &kp RIGHT_PARENTHESIS  &kp HASH       &trans
&trans  &kp CARET        &kp LESS_THAN  &kp EQUAL      &kp GREATER_THAN  &kp DOLLAR      &trans          &trans  &kp GRAVE  &kp LEFT_BRACKET      &kp UNDERSCORE     &kp RIGHT_BRACKET      &kp BACKSLASH  &trans
&trans  &trans           &trans         &trans         &kp LG(LS(N3))    &kp LG(LS(N4))  &kp LG(LS(N5))  &trans  &trans     &trans                &trans             &trans                 &trans         &trans
            >;
        };

        NAV {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        NUM {
            bindings = <
&trans  &trans   &trans   &trans   &trans   &trans                   &trans  &trans  &trans  &trans  &trans     &trans
&trans  &kp F1   &kp F2   &kp F3   &kp F4   &kp F5                   &trans  &kp N7  &kp N8  &kp N9  &kp MINUS  &trans
&trans  &kp F6   &kp F7   &kp F8   &kp F9   &kp F10  &trans  &trans  &trans  &kp N4  &kp N5  &kp N6  &kp MINUS  &trans
&trans  &kp F11  &kp F12  &kp F13  &kp F14  &kp F15  &trans  &trans  &kp N0  &kp N1  &kp N2  &kp N3  &kp DOT    &trans
&trans  &trans   &trans   &trans   &trans   &trans   &trans  &trans  &trans  &trans  &trans  &trans  &trans     &trans
            >;
        };
    };
};
