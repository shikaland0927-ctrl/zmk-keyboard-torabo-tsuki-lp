#include <dt-bindings/zmk/input_transform.h>
#include <input/processors.dtsi>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

&pointing_listener {
    input-processors =
        <&zip_xy_scaler 2 3>,
        <&zip_xy_transform (INPUT_TRANSFORM_X_INVERT | INPUT_TRANSFORM_Y_INVERT)>;

    scroll {
        layers = <4>;
        input-processors =
            <&zip_xy_scaler 2 3>,
            <&zip_xy_transform (INPUT_TRANSFORM_X_INVERT)>,
            <&zip_xy_to_scroll_mapper>,
            <&zip_scroll_scaler 1 16>;
    };

    gesture {
        layers = <5>;
        input-processors =
            <&zip_xy_transform (INPUT_TRANSFORM_X_INVERT | INPUT_TRANSFORM_Y_INVERT)>,
            <&zip_gestures>;
    };

    window {
        layers = <6>;
        input-processors =
            <&zip_xy_transform (INPUT_TRANSFORM_X_INVERT | INPUT_TRANSFORM_Y_INVERT)>,
            <&zip_window_gestures>;
    };
};

&lt {
    hold-while-undecided;
    flavor = "hold-preferred";
};

&mt { flavor = "balanced"; };

/ {
    // Flick the trackball while GESTURE (Esc) or WINDOW (A+O) is held to tap one of its bindings.
    // positions = up, down, left, right on that layer (same keys as the NAV arrows).
    // None of the gestures is used repeatedly, so ignore the ball for 800 ms after one fires.

    zip_gestures: zip_gestures {
        compatible = "zmk,input-processor-gestures";
        #input-processor-cells = <0>;
        layer-id = <5>;
        positions = <34 33 32 35>;
        cooldown-ms = <800>;
    };

    zip_window_gestures: zip_window_gestures {
        compatible = "zmk,input-processor-gestures";
        #input-processor-cells = <0>;
        layer-id = <6>;
        positions = <34 33 32 35>;
        cooldown-ms = <800>;
    };

    combos {
        compatible = "zmk,combos";

        kana {
            bindings = <&tn_combo 4 0>;
            key-positions = <33 34>;
            layers = <0 1>;
        };

        eisuu {
            bindings = <&ao_combo 6 0>;
            key-positions = <28 27>;
            layers = <0 1>;
        };

        xn {
            bindings = <&xn_macro>;
            key-positions = <34 35>;
            layers = <1>;
        };

        minus {
            bindings = <&kp MINUS>;
            key-positions = <27 26>;
            timeout-ms = <40>;
            layers = <1>;
        };

        mb1 {
            bindings = <&mkp MB1>;
            timeout-ms = <80>;
            key-positions = <33 19>;
        };

        mb2 {
            bindings = <&mkp MB2>;
            timeout-ms = <80>;
            key-positions = <35 21>;
        };

        mb3 {
            bindings = <&mkp MB3>;
            timeout-ms = <80>;
            key-positions = <34 20>;
        };
    };

    behaviors {
        lt_to_nav: lt_to_nav {
            compatible = "zmk,behavior-hold-tap";
            label = "LT_TO_NAV";
            bindings = <&mo_to_nav>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <150>;
            hold-while-undecided;
        };

        tog_on: tog_on {
            compatible = "zmk,behavior-toggle-layer";
            label = "TOG_ON";
            #binding-cells = <1>;
            toggle-mode = "on";
        };

        tog_off: tog_off {
            compatible = "zmk,behavior-toggle-layer";
            label = "TOG_OFF";
            #binding-cells = <1>;
            toggle-mode = "off";
        };

        left_in_nav: left_in_nav {
            compatible = "zmk,behavior-mod-morph";
            label = "LEFT_IN_NAV";
            bindings = <&kp LEFT_ARROW>, <&kp LEFT_ARROW>;

            #binding-cells = <0>;
            mods = <(MOD_RGUI)>;
        };

        down_in_nav: down_in_nav {
            compatible = "zmk,behavior-mod-morph";
            label = "DOWN_IN_NAV";
            bindings = <&kp DOWN_ARROW>, <&kp DOWN_ARROW>;

            #binding-cells = <0>;
            mods = <(MOD_RGUI)>;
        };

        up_in_nav: up_in_nav {
            compatible = "zmk,behavior-mod-morph";
            label = "UP_IN_NAV";
            bindings = <&kp UP_ARROW>, <&kp UP_ARROW>;

            #binding-cells = <0>;
            mods = <(MOD_RGUI)>;
        };

        right_in_nav: right_in_nav {
            compatible = "zmk,behavior-mod-morph";
            label = "RIGHT_IN_NAV";
            bindings = <&kp RIGHT_ARROW>, <&kp RIGHT_ARROW>;

            #binding-cells = <0>;
            mods = <(MOD_RGUI)>;
        };

        tn_combo: tn_combo {
            compatible = "zmk,behavior-hold-tap";
            label = "TN_COMBO";
            bindings = <&mo>, <&kana_jp>;

            #binding-cells = <2>;
            flavor = "hold-preferred";
            tapping-term-ms = <150>;
            hold-while-undecided;
        };

        ao_combo: ao_combo {
            compatible = "zmk,behavior-hold-tap";
            label = "AO_COMBO";
            bindings = <&mo>, <&eisuu_default>;

            #binding-cells = <2>;
            flavor = "hold-preferred";
            tapping-term-ms = <150>;
            hold-while-undecided;
        };

        my_mt: my_mt {
            compatible = "zmk,behavior-hold-tap";
            label = "MY_MT";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            flavor = "hold-preferred";
            tapping-term-ms = <200>;
            hold-while-undecided;
            balanced-key-positions = <56 57 58 59 60>;
        };
    };

    macros {
        mo_to_nav: mo_to_nav {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&mo 3 &kp RIGHT_GUI>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&mo 3 &kp RIGHT_GUI>;

            label = "MO_TO_NAV";
        };

        kp_in_nav: kp_in_nav {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings =
                <&macro_release>,
                <&kp RIGHT_GUI>,
                <&macro_tap>,
                <&macro_param_1to1 &kp MACRO_PLACEHOLDER>,
                <&macro_press>,
                <&kp RIGHT_GUI>;

            label = "KP_IN_NAV";
        };

        // Track the input mode only when the kana/eisuu combo is tapped.
        // Explicit on/off also lets repeated taps resynchronize with the host.

        kana_jp: kana_jp {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <30>;
            bindings = <&macro_press>, <&tog_on 1>, <&macro_tap>, <&kp LANG1>;

            label = "KANA_JP";
        };

        eisuu_default: eisuu_default {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <30>;
            bindings = <&macro_press>, <&tog_off 1>, <&macro_tap>, <&kp LANG2>;

            label = "EISUU_DEFAULT";
        };

        xn_macro: xn_macro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp X &kp N>;
            label = "XN_MACRO";
        };

        icloud: icloud {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp S &kp H &kp I &kp K &kp A &kp L &kp A &kp N &kp D &kp N0 &kp N9 &kp N2 &kp N7 &kp AT &kp I &kp C &kp L &kp O &kp U &kp D &kp DOT &kp C &kp O &kp M>;
            label = "ICLOUD";
        };

        eccs: eccs {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp S &kp H &kp I &kp K &kp A &kp L &kp A &kp N &kp D &kp N0 &kp N9 &kp N2 &kp N7 &kp AT &kp G &kp DOT &kp E &kp C &kp C &kp DOT &kp U &kp MINUS &kp T &kp O &kp K &kp Y &kp O &kp DOT &kp A &kp C &kp DOT &kp J &kp P>;
            label = "ECCS";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        DEFAULT {
            bindings = <
&trans  &trans                         &trans                             &trans         &trans        &trans                                                    &trans              &trans  &trans  &trans                           &trans                        &trans
&trans  &kp Q                          &kp Y                              &kp U          &kp J         &kp L                                                     &kp G               &kp D   &kp M   &kp Z                            &kp B                         &trans
&trans  &kp E                          &kp I                              &kp A          &kp O         &kp F        &trans                        &trans         &kp K               &kp T   &kp N   &kp S                            &kp H                         &trans
&trans  &my_mt LEFT_SHIFT COLON        &mt LEFT_GUI PERIOD                &kp C          &kp V         &kp X        &trans                        &trans         &kp P               &kp W   &kp R   &mt RIGHT_GUI COMMA              &my_mt RIGHT_SHIFT SEMICOLON  &trans
&trans  &mt LEFT_ALT C_BRIGHTNESS_DEC  &mt LEFT_CONTROL C_BRIGHTNESS_INC  &kp LG(LC(Q))  &lt 5 ESCAPE  &lt 2 ENTER  &mt LC(LA(LS(LEFT_GUI))) TAB  &kp BACKSPACE  &lt_to_nav 0 SPACE  &trans  &trans  &mt RIGHT_CONTROL C_VOLUME_DOWN  &mt RIGHT_ALT C_VOLUME_UP     &trans
            >;
        };

        // Keep JP transparent and right above DEFAULT, so combos limited to
        // DEFAULT/JP stay off while SYMBOL or NAV is held.

        JP {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        SYMBOL {
            bindings = <
&trans  &trans                &trans                &trans                &trans            &trans                       &trans     &trans                &trans             &trans                 &trans         &trans
&trans  &kp EXCLAMATION       &kp QUESTION          &kp AMPERSAND         &kp PIPE          &kp TILDE                    &trans     &kp LEFT_BRACE        &kp SQT            &kp RIGHT_BRACE        &kp BACKSLASH  &trans
&trans  &kp PLUS              &kp MINUS             &kp ASTERISK          &kp SLASH         &kp PERCENT  &trans  &trans  &trans     &kp LEFT_PARENTHESIS  &kp DOUBLE_QUOTES  &kp RIGHT_PARENTHESIS  &kp HASH       &trans
&trans  &kp CARET             &kp LESS_THAN         &kp EQUAL             &kp GREATER_THAN  &kp DOLLAR   &trans  &trans  &kp GRAVE  &kp LEFT_BRACKET      &kp UNDERSCORE     &kp RIGHT_BRACKET      &kp AT         &trans
&trans  &kp LG(LS(NUMBER_3))  &kp LG(LS(NUMBER_4))  &kp LG(LS(NUMBER_5))  &trans            &trans       &trans  &trans  &trans     &trans                &trans             &icloud                &eccs          &trans
            >;
        };

        NAV {
            bindings = <
&trans  &trans               &trans               &trans               &trans               &trans                             &trans                       &trans                           &trans                            &trans                        &trans                   &trans
&trans  &trans               &kp_in_nav N7        &kp_in_nav NUMBER_8  &kp_in_nav NUMBER_9  &kp_in_nav MINUS                   &kp_in_nav LC(LEFT_ARROW)    &kp GRAVE                        &kp TAB                           &kp_in_nav RC(RIGHT_ARROW)    &trans                   &trans
&trans  &trans               &kp_in_nav NUMBER_4  &kp_in_nav N5        &kp_in_nav NUMBER_6  &kp_in_nav PLUS    &trans  &trans  &left_in_nav                 &down_in_nav                     &up_in_nav                        &right_in_nav                 &kp_in_nav END           &trans
&trans  &kp_in_nav NUMBER_0  &kp_in_nav NUMBER_1  &kp_in_nav NUMBER_2  &kp_in_nav NUMBER_3  &kp_in_nav PERIOD  &trans  &trans  &kp_in_nav LG(LEFT_BRACKET)  &kp_in_nav LS(LG(LEFT_BRACKET))  &kp_in_nav RS(RG(RIGHT_BRACKET))  &kp_in_nav RG(RIGHT_BRACKET)  &trans                   &trans
&trans  &trans               &trans               &trans               &trans               &trans             &trans  &trans  &trans                       &trans                           &trans                            &trans                        &trans                   &trans
            >;
        };

        SCROLL {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        // Hold Esc. The K/T/N/S bindings are also the trackball flick
        // left/down/up/right (read by &zip_gestures above).

        GESTURE {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                  &trans   &trans              &trans            &trans         &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &trans   &trans              &trans            &trans         &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &kp F11  &kp LC(DOWN_ARROW)  &kp LC(UP_ARROW)  &kp LG(LC(F))  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans   &trans              &trans            &trans         &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans   &trans              &trans            &trans         &trans  &trans
            >;
        };

        // Hold A+O (tap is eisuu). The K/T/N/S bindings are also the trackball
        // flick left/down/up/right (read by &zip_window_gestures above).

        WINDOW {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                  &trans                  &trans                  &trans                &trans                   &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &trans                  &trans                  &trans                &trans                   &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &kp LC(LG(LEFT_ARROW))  &kp LC(LG(DOWN_ARROW))  &kp LC(LG(UP_ARROW))  &kp LC(LG(RIGHT_ARROW))  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans                  &trans                  &trans                &trans                   &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans                  &trans                  &trans                &trans                   &trans  &trans
            >;
        };
    };
};
